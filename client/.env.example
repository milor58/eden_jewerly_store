# Copy to .env.development (local) or set these in Vercel (production).
# Every VITE_ value is visible in the browser: never put secrets here.

# Where the API runs. Local default is http://localhost:5000
VITE_API_URL=http://localhost:5000

# Workshop WhatsApp number, international format, digits only (e.g. 96170123456).
# Turns on: the round WhatsApp button on every page, "Ask about this ring" on each ring,
# and "Send this cart on WhatsApp" in the cart. Empty = the buttons are hidden.
VITE_WHATSAPP_NUMBER=96171993378
