# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (add /eden before the ?)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eden?retryWrites=true&w=majority

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Front-end URL(s) allowed by CORS. No trailing slash. Separate several with commas.
CLIENT_ORIGIN=http://localhost:5173

# Admin account created by `npm run seed`
ADMIN_NAME=Eden Owner
ADMIN_EMAIL=admin@eden.test
ADMIN_PASSWORD=change-me-admin-123

# ImageKit (free plan) for ring photos uploaded from the admin dashboard.
# imagekit.io -> Dashboard -> Developer options -> API keys -> Private key.
# Keep it secret: only here and in Render, never in the client or on GitHub.
IMAGEKIT_PRIVATE_KEY=
